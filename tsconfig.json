{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "sourceRoot": "src",
    "types": ["node", "reflect-metadata"]
  },
  "include": [
    "src/**/*"
  ]
}